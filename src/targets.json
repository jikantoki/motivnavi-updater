{
  "targets": [
    {
      "id": "mediablue",
      "name": "Mediablue",
      "description": "Bluetooth再生中の曲情報表示",
      "path": "/motivnavi/mediablue",
      "post_update": [
        {
          "label": ".deb をビルド (scripts/build-deb.sh)",
          "command": ["./scripts/build-deb.sh"],
          "as": "root"
        },
        {
          "label": ".deb をインストール (dist/mediablue.deb)",
          "command": ["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "--reinstall", "-o", "Dpkg::Use-Pty=0", "./dist/mediablue.deb"],
          "as": "root"
        }
      ]
    },
    {
      "id": "linuxauto",
      "name": "Linux Auto",
      "description": "Android Auto (Google DHU) 対応ツール",
      "path": "/motivnavi/linuxauto",
      "post_update": [
        {
          "label": ".deb をビルド (build-deb.sh)",
          "command": ["./build-deb.sh"],
          "as": "root"
        },
        {
          "label": ".deb をインストール (dist/linux-auto.deb)",
          "command": ["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "--reinstall", "-o", "Dpkg::Use-Pty=0", "./dist/linux-auto.deb"],
          "as": "root"
        }
      ]
    },
    {
      "id": "welcome",
      "name": "Welcome to Motivnavi",
      "description": "Motivnavi OS のウェルカムアプリ",
      "path": "/motivnavi/motivnavi-welcome",
      "post_update": [
        {
          "label": ".deb をビルド (build-deb.sh)",
          "command": ["./build-deb.sh"],
          "as": "root"
        },
        {
          "label": ".deb をインストール (dist/motivnavi.deb)",
          "command": ["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "--reinstall", "-o", "Dpkg::Use-Pty=0", "./dist/motivnavi.deb"],
          "as": "root"
        }
      ]
    },
    {
      "id": "screentweaks",
      "name": "Motivnavi Screentweaks",
      "description": "画面の点灯・スリープ設定（スクリーン設定）",
      "path": "/motivnavi/motivnavi-screentweaks",
      "post_update": [
        {
          "label": ".deb をビルド (build-deb.sh)",
          "command": ["./build-deb.sh"],
          "as": "root"
        },
        {
          "label": ".deb をインストール (dist/motivnavi-screentweaks.deb)",
          "command": ["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "--reinstall", "-o", "Dpkg::Use-Pty=0", "./dist/motivnavi-screentweaks.deb"],
          "as": "root"
        }
      ]
    },
    {
      "id": "updater",
      "name": "Motivnavi Updater",
      "description": "このアップデーター自身",
      "path": "/motivnavi/updater",
      "self": true,
      "post_update": [
        {
          "label": "最新の .deb をビルドしてインストール",
          "command": ["./build-deb.sh", "--install"],
          "as": "root"
        }
      ]
    }
  ]
}
