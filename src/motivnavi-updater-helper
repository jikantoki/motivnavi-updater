#!/usr/bin/python3 -I
# -*- coding: utf-8 -*-
# =============================================================================
# Motivnavi Updater - 特権ヘルパー (motivnavi-updater-helper)
# 開発者: エノキ電気 ENOKI ELECTRONICS (https://enoki.xyz)
#
# GUI から「sudo」経由で呼び出され、設定ファイル (targets.json) に書かれた
# アップデート対象に対してだけ git fetch / git pull / 後処理コマンドを実行します。
# 任意のコマンドは受け付けません (対象 ID と後処理の番号だけを受け取ります)。
#
# 使い方:
#   motivnavi-updater-helper info  <対象ID>   (fetch して状態を JSON で出力)
#   motivnavi-updater-helper clone <対象ID>   (未インストールのとき repo から path に取得)
#   motivnavi-updater-helper fetch <対象ID>
#   motivnavi-updater-helper pull  <対象ID>
#   motivnavi-updater-helper post  <対象ID> <後処理の番号>
#     (後処理の "as": "root" は root で、"owner" はリポジトリの所有者で実行)
#   motivnavi-updater-helper list
# =============================================================================

import json
import os
import pwd
import shutil
import subprocess
import sys

INSTALLED_DIR = "/usr/lib/motivnavi-updater"
SYSTEM_CONFIG = "/etc/motivnavi-updater/targets.json"


def say(msg):
    print(msg, flush=True)


def config_path():
    here = os.path.dirname(os.path.realpath(__file__))
    # インストール済みのヘルパーは root 所有の /etc の設定だけを読む
    if here == INSTALLED_DIR or os.path.exists(SYSTEM_CONFIG):
        return SYSTEM_CONFIG
    return os.path.join(here, "targets.json")


def load_targets():
    path = config_path()
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:  # noqa: BLE001
        say(f"[エラー] 設定ファイルを読み込めません: {path} ({e})")
        sys.exit(2)
    return {t["id"]: t for t in data.get("targets", [])}


def get_target(tid):
    targets = load_targets()
    t = targets.get(tid)
    if t is None:
        say(f"[エラー] 不明な対象です: {tid}")
        sys.exit(2)
    path = t.get("path", "")
    if not os.path.isabs(path) or not os.path.isdir(os.path.join(path, ".git")):
        say(f"[エラー] git リポジトリが見つかりません: {path}")
        sys.exit(3)
    return t


def owner_preexec(path):
    """リポジトリの所有者で git を実行するための preexec (所有権を崩さないため)。"""
    try:
        st = os.stat(os.path.join(path, ".git"))
    except OSError:
        return None, None
    if os.geteuid() != 0 or st.st_uid == 0:
        return None, None
    uid, gid = st.st_uid, st.st_gid
    env = dict(os.environ)
    name = None
    try:
        pw = pwd.getpwuid(uid)
        name, gid = pw.pw_name, pw.pw_gid
        env.update(HOME=pw.pw_dir, USER=pw.pw_name, LOGNAME=pw.pw_name)
    except KeyError:
        pass

    def _drop():
        os.setgid(gid)
        if name:
            os.initgroups(name, gid)
        else:
            os.setgroups([])
        os.setuid(uid)

    return _drop, env


def run(cmd, cwd, preexec=None, env=None):
    say("$ " + " ".join(cmd))
    env = dict(env or os.environ)
    env["GIT_TERMINAL_PROMPT"] = "0"
    try:
        r = subprocess.run(cmd, cwd=cwd, stdin=subprocess.DEVNULL,
                           preexec_fn=preexec, env=env)
    except FileNotFoundError:
        say(f"[エラー] コマンドが見つかりません: {cmd[0]}")
        return 127
    return r.returncode


def git(t, *args):
    # core.fileMode=false: /motivnavi の権限を chmod で変えても「変更あり」と扱わない (pull が止まらないように)
    # git は root (sudo) で実行する。.git の中に root 所有と一般ユーザー所有のファイルが
    # 混ざっていても失敗しないようにするため (/motivnavi 以下は sudo 必須の前提)
    path = t["path"]
    cmd = ["git", "-c", f"safe.directory={path}", "-c", "core.fileMode=false", "-C", path, *args]
    return run(cmd, path, repo_umask(path))


def repo_umask(path):
    """git が書き出すファイルの権限を、リポジトリのフォルダの権限に合わせる preexec。
    例: フォルダが 750 なら umask 027 (他ユーザーは読み書き・実行不可) で書き出す。"""
    try:
        mode = os.stat(path).st_mode
    except OSError:
        return None
    mask = (~mode) & 0o077

    def _set():
        os.umask(mask)

    return _set


INFO_MARK = "@@MOTIVNAVI_INFO@@ "


def git_capture(path, *args, timeout=120):
    env = dict(os.environ)
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["LC_ALL"] = "C"
    try:
        r = subprocess.run(["git", "-c", f"safe.directory={path}", "-c", "core.fileMode=false", "-C", path, *args],
                           capture_output=True, text=True, stdin=subprocess.DEVNULL,
                           env=env, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except subprocess.TimeoutExpired:
        return 124, "", "タイムアウトしました"


def commit_json(path, ref):
    rc, out, _ = git_capture(path, "log", "-1", "--format=%H%x1f%h%x1f%cI%x1f%an%x1f%s", ref)
    if rc != 0 or not out:
        return None
    h, short, date, author, subject = (out.split("\x1f") + [""] * 5)[:5]
    return {"hash": h, "short": short, "date": date, "author": author, "subject": subject}


def info(t):
    """root で fetch してアップデート状況を調べる (GUI の「更新を確認」用)。"""
    path = t.get("path", "")
    res = {"id": t["id"], "status": "error", "message": "", "local": None, "remote": None,
           "behind": None, "ahead": 0, "incoming": [], "fetched": False}
    if not os.path.isabs(path) or not os.path.isdir(os.path.join(path, ".git")):
        res["status"] = "missing"
        res["message"] = f"{path} に git リポジトリが見つかりません"
        return res
    res["local"] = commit_json(path, "HEAD")
    if res["local"] is None:
        res["message"] = "現在のコミットを取得できません"
        return res
    branch = t.get("branch")
    remote = "origin"
    if not branch:
        rc, up, _ = git_capture(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
        if rc == 0 and "/" in up:
            remote, branch = up.split("/", 1)
        else:
            _, branch, _ = git_capture(path, "rev-parse", "--abbrev-ref", "HEAD")
    ref = f"{remote}/{branch}"
    rc, _, err = git_capture(path, "fetch", "--prune", remote)
    res["fetched"] = rc == 0
    if rc != 0:
        lines = err.splitlines()
        res["message"] = "リモートに接続できません" + (f": {lines[-1]}" if lines else "")
        if git_capture(path, "rev-parse", "--verify", "-q", ref)[0] != 0:
            return res
    res["remote"] = commit_json(path, ref)
    _, behind, _ = git_capture(path, "rev-list", "--count", f"HEAD..{ref}")
    _, ahead, _ = git_capture(path, "rev-list", "--count", f"{ref}..HEAD")
    res["behind"] = int(behind or 0)
    res["ahead"] = int(ahead or 0)
    if res["behind"]:
        _, log, _ = git_capture(path, "log", "-n", "50", "--format=%h%x1f%cI%x1f%an%x1f%s", f"HEAD..{ref}")
        for line in log.splitlines():
            h, d, a, subj = (line.split("\x1f") + [""] * 4)[:4]
            res["incoming"].append({"short": h, "date": d, "author": a, "subject": subj})
        res["status"] = "update"
    elif res["ahead"]:
        res["status"] = "ahead"
    elif res["fetched"]:
        res["status"] = "latest"
    return res


def clone(t):
    """repo の URL から path に git clone する (path に無いときだけ)。"""
    path, repo = t.get("path", ""), t.get("repo", "")
    if not os.path.isabs(path):
        say(f"[エラー] path が不正です: {path}")
        return 2
    if not (repo.startswith("https://") or repo.startswith("git@")):
        say("[エラー] この対象には取得元のリポジトリ (repo) が設定されていません")
        return 2
    if os.path.isdir(os.path.join(path, ".git")):
        say(f"{path} は既にあります。clone はスキップします")
        return 0
    if os.path.exists(path) and (not os.path.isdir(path) or os.listdir(path)):
        say(f"[エラー] {path} が既にあり、空ではありません。中身を確認してください")
        return 3
    parent = os.path.dirname(path.rstrip("/"))
    if not os.path.isdir(parent):
        say(f"$ mkdir -p {parent}")
        os.makedirs(parent, mode=0o755, exist_ok=True)
    say(f"==> {t.get('name', t['id'])}: git clone {repo} → {path}")
    cmd = ["git", "clone"]
    if t.get("branch"):
        cmd += ["--branch", t["branch"]]
    cmd += [repo, path]
    # 書き出すファイルの権限は親フォルダ (/motivnavi) の権限に合わせる
    return run(cmd, parent, repo_umask(parent))


def resolve_command(cmd, cwd):
    cmd = list(cmd)
    if not cmd:
        return cmd
    # ./script.sh に実行権限が無い場合は bash で実行 (先頭の env VAR=値 は飛ばして判定)
    i = 0
    if cmd[0] == "env":
        i = 1
        while i < len(cmd) and "=" in cmd[i] and not cmd[i].startswith("./"):
            i += 1
    if i < len(cmd) and cmd[i].startswith("./"):
        p = os.path.join(cwd, cmd[i][2:])
        if os.path.isfile(p) and not os.access(p, os.X_OK):
            cmd = cmd[:i] + ["bash"] + cmd[i:]
    # docker compose (v2) が無ければ docker-compose (v1) を使う
    if cmd[:2] == ["docker", "compose"]:
        ok = subprocess.run(["docker", "compose", "version"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                            ).returncode == 0 if shutil.which("docker") else False
        if not ok and shutil.which("docker-compose"):
            cmd = ["docker-compose"] + cmd[2:]
    return cmd


def main(argv):
    if len(argv) < 2:
        say(__doc__ or "usage: motivnavi-updater-helper fetch|pull|post|list ...")
        return 2
    action = argv[1]

    if action == "list":
        for tid, t in load_targets().items():
            say(f"{tid}\t{t.get('path')}")
        return 0

    if len(argv) < 3:
        say("[エラー] 対象IDを指定してください")
        return 2

    if action == "clone":
        t = load_targets().get(argv[2])
        if t is None:
            say(f"[エラー] 不明な対象です: {argv[2]}")
            return 2
        return clone(t)

    if action == "info":
        t = load_targets().get(argv[2])
        if t is None:
            say(f"[エラー] 不明な対象です: {argv[2]}")
            return 2
        say(INFO_MARK + json.dumps(info(t), ensure_ascii=False))
        return 0

    t = get_target(argv[2])
    branch = t.get("branch")

    if action == "fetch":
        return git(t, "fetch", "--prune", "origin")

    if action == "pull":
        say(f"==> {t.get('name', t['id'])}: git pull ({t['path']})")
        args = ["pull", "--ff-only"]
        if branch:
            args += ["origin", branch]
        return git(t, *args)

    if action == "post":
        try:
            idx = int(argv[3])
            step = t.get("post_update", [])[idx]
        except (IndexError, ValueError):
            say("[エラー] 後処理の番号が不正です")
            return 2
        mode = step.get("as", "root")
        if mode not in ("root", "owner"):
            say("[エラー] この後処理は一般ユーザーで実行する設定です")
            return 2
        say(f"==> {t.get('name', t['id'])}: {step.get('label', '後処理')}")
        cmd = resolve_command(step["command"], t["path"])
        if mode == "owner":
            # リポジトリの所有者として実行 (ビルド成果物の所有者をそろえるため)
            preexec, env = owner_preexec(t["path"])
            return run(cmd, t["path"], preexec, env)
        return run(cmd, t["path"])

    say(f"[エラー] 不明な操作です: {action}")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
